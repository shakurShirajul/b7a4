model Rental {
  id              Int          @id @default(autoincrement())
  property        Property     @relation(fields: [propertyId], references: [id])
  propertyId      Int
  tenant          User         @relation("TenantRequests", fields: [tenantId], references: [id])
  tenantId        Int
  landlord        User         @relation("LandlordRequests", fields: [landlordId], references: [id])
  landlordId      Int          @map("landLordId")
  message         String
  status          RentalStatus @default(PENDING)
  moveInDate      DateTime?
  startDate       DateTime?
  endDate         DateTime?
  approvedAt      DateTime?
  rejectedAt      DateTime?
  rejectionReason String?
  deletedAt       DateTime?

  review   Review?
  payments Payment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([landlordId])
  @@index([propertyId])
  @@index([status])
  @@index([propertyId, tenantId, status])
  @@index([deletedAt])
}
