model User {
    id        Int        @id @default(autoincrement())
    name      String
    email     String     @unique
    password  String
    phone     String?    @unique
    avatarUrl String?
    role      Role       @default(TENANT)
    status    UserStatus @default(ACTIVE)

    refreshTokenHash      String?
    refreshTokenExpiresAt DateTime?

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    properties       Property[]
    reviews          Review[]
    payments         Payment[]
    tenantRequests   Request[]  @relation("TenantRequests")
    landlordRequests Request[]  @relation("LandlordRequests")
}
